FROM python:3.11-slim
WORKDIR /app
COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt && useradd --create-home appuser
COPY src/ src/
RUN chown -R appuser:appuser /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src CHECKPOINT_PATH=/app/checkpoints/classifier_v1.pt
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')"
ENTRYPOINT ["python", "src/serve.py"]
